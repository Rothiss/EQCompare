			<OnLoad>
				tinsert(UISpecialFrames, this:GetName());
				this:RegisterForDrag("LeftButton");
			</OnLoad>
			<OnShow>
				PlaySound("igMainMenuOpen");
				EQCompare_Options_OnShow();
			</OnShow>
			<OnHide>
				PlaySound("igMainMenuClose");
				GameTooltip:Hide();
			</OnHide>
			<OnDragStart>
				this:StartMoving();
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing();
